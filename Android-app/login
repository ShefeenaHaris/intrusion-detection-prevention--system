  void _send_data() async {
    String uname = _usernametextController.text.trim();
    String password = _passwordtextController.text.trim();

    if (uname.isEmpty || password.isEmpty) {
      Fluttertoast.showToast(msg: "Please fill in all fields");
      return;
    }

    SharedPreferences sh = await SharedPreferences.getInstance();
    String? url = sh.getString('url');

    if (url == null) {
      Fluttertoast.showToast(msg: "Server URL not configured");
      return;
    }

    final urls = Uri.parse('$url/user_login_post/');
    try {
      final response = await http.post(urls, body: {
        'Username': uname,
        'Password': password,
      });
      if (response.statusCode == 200) {
        var data = jsonDecode(response.body);
        String status = data['status'];
        if (status == 'ok') {
          String lid = data['lid'];
          String c = data['c'].toString();
          await sh.setString("lid", lid);
          await sh.setString("c", c);
          Navigator.pushReplacement(
            context,
            MaterialPageRoute(builder: (context) => const BankingDashboard()),
          );
        } else {
          Fluttertoast.showToast(msg: 'Invalid credentials');
        }
      } else {
        Fluttertoast.showToast(msg: 'Network error: ${response.statusCode}');
      }
    } catch (e) {
      Fluttertoast.showToast(msg: 'Error: $e');
    }
  }
}
