          child: isLoading
              ? Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                CircularProgressIndicator(
                  valueColor: AlwaysStoppedAnimation<Color>(const Color(0xFF2A4B7C)),
                ),
                const SizedBox(height: 20),
                Text(
                  "Loading your complaints...",
                  style: TextStyle(
                    color: Colors.grey[600],
                    fontSize: 16,
