                Container(
                  width: 120,
                  height: 120,
                  decoration: BoxDecoration(
                    color: const Color(0xFF2A4B7C).withOpacity(0.1),
                    shape: BoxShape.circle,
                  ),
                  child: const Icon(
                    Icons.inbox,
                    size: 60,
                    color: Color(0xFF2A4B7C),
                  ),
                ),
                const SizedBox(height: 20),
                const Text(
                  "No Complaints Yet",
                  style: TextStyle(
