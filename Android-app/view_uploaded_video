  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({Key? key}) : super(key: key);

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: User_View_New_Video(),
      debugShowCheckedModeBanner: false,
    );
  }
}

class User_View_New_Video extends StatefulWidget {
  const User_View_New_Video({Key? key}) : super(key: key);

  @override
  State<User_View_New_Video> createState() => _User_View_New_VideoState();
}

class _User_View_New_VideoState extends State<User_View_New_Video> {
  List<String> id_ = <String>[];
  List<String> title_ = <String>[];
  List<String> video_ = <String>[];
  List<String> name_ = <String>[];
  bool isLoading = true;

  @override
  void initState() {
    super.initState();
    view_notification();
  }

  Future<void> view_notification() async {
    List<String> id = <String>[];
    List<String> title = <String>[];
    List<String> video = <String>[];
    List<String> name = <String>[];

    try {
      SharedPreferences sh = await SharedPreferences.getInstance();
      String urls = sh.getString('url').toString();
      String e_id = sh.getString('eid').toString();
      String url = '$urls/user_view_video/';

      var data = await http.post(
        Uri.parse(url),
        body: {
          'eid': e_id,
        },
      ).timeout(const Duration(seconds: 30));

      var jsondata = json.decode(data.body);
      var arr = jsondata["data"];

      String baseUrl = sh.getString("img_url").toString();

      for (int i = 0; i < arr.length; i++) {
        id.add(arr[i]['id'].toString());
        title.add(arr[i]['title'].toString());
        name.add(arr[i]['name'].toString());

        // Construct full video URL
        // String fullVideoUrl = arr[i]['video'];
        String videoPath = arr[i]['video'];
        String fullVideoUrl = baseUrl + videoPath;

        // Fix URL formatting issues
        if (fullVideoUrl.startsWith('http:/') && !fullVideoUrl.startsWith('http://')) {
          fullVideoUrl = fullVideoUrl.replaceFirst('http:/', 'http://');
        }
        if (fullVideoUrl.startsWith('https:/') && !fullVideoUrl.startsWith('https://')) {
          fullVideoUrl = fullVideoUrl.replaceFirst('https:/', 'https://');
        }

        video.add(fullVideoUrl);
      }

      setState(() {
        id_ = id;
        title_ = title;
        name_ = name;
        video_ = video;
        isLoading = false;
      });

    } catch (e) {
      print("Error ------------------- " + e.toString());
      setState(() {
        isLoading = false;
      });
    }
  }

  // Method 1: Launch in browser
  Future<void> _launchInBrowser(String videoUrl) async {
    final Uri url = Uri.parse(videoUrl);
    if (await canLaunchUrl(url)) {
      await launchUrl(
        url,
        mode: LaunchMode.externalApplication, // This forces browser
      );
    }
  }

  // Method 2: Launch with specific intent for Android
  Future<void> _launchWithIntent(String videoUrl) async {
    final Uri url = Uri.parse(videoUrl);
    // For Android, we can specify we want to view the video
    await launchUrl(
      url,
      mode: LaunchMode.externalNonBrowserApplication, // Try to find a video player
    );
  }

  // Method 3: Show dialog with options
  void _showPlayOptions(String videoUrl) {
    showModalBottomSheet(
      context: context,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (context) {
        return SafeArea(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              const Padding(
                padding: EdgeInsets.all(16),
                child: Text(
                  'Play Video',
                  style: TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
              // ListTile(
              //   leading: const Icon(Icons.open_in_browser, color: Colors.blue),
              //   title: const Text('Open in Browser'),
              //   onTap: () {
              //     Navigator.pop(context);
              //     _launchInBrowser(videoUrl);
              //   },
              // ),
              ListTile(
                leading: const Icon(Icons.video_library, color: Colors.blue),
                title: const Text('Open in Video Player'),
                onTap: () {
                  Navigator.pop(context);
                  _launchWithIntent(videoUrl);
                },
              ),
              const SizedBox(height: 10),
            ],
          ),
        );
      },
    );
  }

